<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_small"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ProgressBar
            android:id="@+id/wRing"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:max="100"
            android:maxHeight="36dp"
            android:maxWidth="36dp"
            android:minHeight="36dp"
            android:minWidth="36dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_ring" />

        <ProgressBar
            android:id="@+id/wRingHot"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:max="100"
            android:maxHeight="36dp"
            android:maxWidth="36dp"
            android:minHeight="36dp"
            android:minWidth="36dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_ring_hot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wRingText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wStripLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/wStripSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wStripValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="#FFFF7A1A"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
