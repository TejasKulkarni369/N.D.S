<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.nds.GlowBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/nav_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp">

            <View
                android:id="@+id/navPill"
                android:layout_width="1dp"
                android:layout_height="45dp"
                android:background="@drawable/nav_active" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Home"
                    android:textColor="@color/on_orange"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/navLimits"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Limits"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <!-- empty slot: the round Focus button sits here -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/navTasks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tasks"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <!-- the 4th tab: Time Table (id kept as navApps) -->
                <TextView
                    android:id="@+id/navApps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="13sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="Time Table"
                    android:textColor="@color/text_dim" />
            </LinearLayout>

            <ImageView
                android:id="@+id/focusBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_focus_btn"
                android:clickable="true"
                android:contentDescription="Focus"
                android:elevation="10dp"
                android:focusable="true"
                android:outlineAmbientShadowColor="@color/orange"
                android:outlineSpotShadowColor="@color/orange"
                android:padding="15dp"
                android:src="@drawable/ic_focus" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>