<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
        android:paddingBottom="104dp"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N.D.S"
        android:textColor="@color/orange_soft"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tasks"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/glass_card"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:text="Add your work with a time. A reminder pops up when the time arrives."
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <FrameLayout
            android:minHeight="220dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.recyclerview.widget.RecyclerView
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
            android:id="@+id/taskList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/taskEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No tasks yet.\
Tap Add task to schedule one."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    
</LinearLayout>
</androidx.core.widget.NestedScrollView>

<!-- pinned to the nav bar: always visible, never scrolls away -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/pinned_fade"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addTaskBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        android:outlineAmbientShadowColor="@color/orange"
        android:outlineSpotShadowColor="@color/orange"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Add task"
        android:textColor="@color/on_orange"
        android:textStyle="bold"
        app:backgroundTint="@color/orange"
        app:cornerRadius="20dp" />
</FrameLayout>
</FrameLayout>
